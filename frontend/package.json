  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "jsdom": "25.0.1",
    "playwright-core": "1.49.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vitest": "2.1.8"
  }
}
